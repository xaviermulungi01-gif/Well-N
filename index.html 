:root {
  --bg: #fffaf2;
  --bg-soft: #f7efe5;
  --card: #ffffff;
  --dark: #1f2d2a;
  --muted: #4f6665;
  --peach: #ffb18a;
  --blue: #9bd7e8;
  --yellow: #f8df76;
  --mint: #cfeecf;
  --shadow: rgba(31, 45, 42, 0.12);
  --accent: #76c9b6;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: linear-gradient(180deg, #fffaf6 0%, #fff7ef 100%);
  color: var(--dark);
  line-height: 1.5;
}

a { text-decoration: none; color: inherit; }
img { max-width: 100%; display: block; }

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 5vw;
  background: rgba(255, 250, 246, 0.9);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid rgba(35, 52, 49, 0.08);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 900;
  font-size: clamp(1.4rem, 2vw, 2rem);
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8f5d, #ffd66a);
  color: white;
  font-size: 1.1rem;
}

nav {
  display: flex;
  gap: 20px;
  align-items: center;
  font-weight: 700;
}

.nav-cta {
  background: var(--accent);
  color: #10332f;
  padding: 10px 16px;
  border-radius: 999px;
}

.hero {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 34px;
  align-items: center;
  padding: 4rem 5vw 2rem;
  position: relative;
}

.hero-copy { max-width: 620px; }

.eyebrow {
  display: inline-block;
  background: rgba(118, 201, 182, 0.18);
  color: #1f695c;
  padding: 9px 14px;
  border-radius: 999px;
  letter-spacing: 0.08em;
  font-size: 0.76rem;
  font-weight: 800;
  text-transform: uppercase;
}

.hero-copy h1 {
  margin: 22px 0 18px;
  font-size: clamp(3rem, 6vw, 5.2rem);
  line-height: 0.95;
  letter-spacing: -0.05em;
}

.hero-copy h1 span { color: #1f6b63; }

.hero-intro {
  font-size: 1.2rem;
  color: var(--muted);
  max-width: 540px;
  margin-bottom: 28px;
}

.button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, #ff8f5d, #ffb36b);
  color: #fff;
  font-weight: 800;
  padding: 15px 24px;
  border-radius: 999px;
  box-shadow: 0 12px 24px rgba(255, 143, 93, 0.25);
}

.hero-photo { position: relative; }

.hero-photo img {
  height: 560px;
  object-fit: cover;
  border-radius: 32px;
  box-shadow: 0 18px 35px rgba(43, 61, 58, 0.12);
}

.photo-sticker {
  position: absolute;
  right: -12px;
  bottom: 28px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(31,45,42,0.06);
  padding: 12px 18px;
  border-radius: 20px;
  font-weight: 800;
  box-shadow: 0 8px 18px rgba(31,45,42,0.08);
}

.sunburst {
  position: absolute;
  left: 56%;
  top: 10%;
  font-size: 4rem;
  color: rgba(255, 214, 106, 0.8);
}

.section-wrap { padding: 3rem 5vw 1rem; }

.section-title { margin-bottom: 22px; }

.section-title h2 {
  margin: 14px 0 0;
  font-size: clamp(2.2rem, 4vw, 3.3rem);
}

.habit-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.habit-card {
  background: var(--card);
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 0 14px 28px var(--shadow);
}

.habit-card img {
  height: 260px;
  object-fit: cover;
}

.card-label {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 24px 20px;
  font-size: 1.3rem;
}

.card-peach { background: #fff4ee; }
.card-blue { background: #edfaff; }
.card-yellow { background: #fff8d9; }

.quote-band {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 18px;
  text-align: center;
  background: linear-gradient(90deg, rgba(207,238,207,0.8), rgba(255,223,118,0.8));
  margin: 3rem 5vw 1rem;
  border-radius: 28px;
  padding: 28px 18px;
}

.quote-icon { font-size: 2rem; }

.quote-band p {
  margin: 0;
  font-size: clamp(1.1rem, 2vw, 1.6rem);
  font-weight: 700;
}

.text-link {
  font-weight: 800;
  color: #0d5d54;
}

.footer {
  padding: 2.2rem 5vw 3rem;
  text-align: center;
}

.footer-brand {
  display: inline-flex;
  justify-content: center;
  margin-bottom: 10px;
}

.footer p {
  max-width: 760px;
  margin: 0 auto;
  color: var(--muted);
}

@media (max-width: 820px) {
  .hero { grid-template-columns: 1fr; }
  .habit-grid { grid-template-columns: 1fr; }
  nav { gap: 10px; font-size: 0.92rem; }
}

@media (max-width: 560px) {
  .topbar { flex-direction: column; gap: 12px; }
  nav {
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
  }
  .hero-copy h1 { line-height: 1; }
  .hero-photo img { height: 420px; }
